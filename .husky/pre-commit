#!/bin/sh

# Run theme validation - check for hardcoded colors in component styles
echo "Checking for hardcoded colors in component styles..."

# Check for hardcoded hex colors in styles.ts files
HARDCODED_COLORS=$(git diff --cached --name-only | grep -E "packages/core/src/.*/styles\.ts$" | xargs grep -l "#[0-9a-fA-F]\{3,6\}" 2>/dev/null | grep -v node_modules || true)

if [ -n "$HARDCODED_COLORS" ]; then
  echo ""
  echo "ERROR: Hardcoded colors found in component styles!"
  echo ""
  echo "Files with hardcoded colors:"
  for file in $HARDCODED_COLORS; do
    echo "  - $file"
    grep -n "#[0-9a-fA-F]\{3,6\}" "$file" | head -5
  done
  echo ""
  echo "Please use CSS variables from the theme system instead."
  echo "See packages/tokens/src/light.css and dark.css for available variables."
  echo ""
  exit 1
fi

# Check for rgba() with hardcoded values in styles.ts files (excluding CSS variable fallbacks)
RGBA_COLORS=$(git diff --cached --name-only | grep -E "packages/core/src/.*/styles\.ts$" | xargs grep -l "rgba([0-9]" 2>/dev/null | grep -v node_modules || true)

if [ -n "$RGBA_COLORS" ]; then
  echo ""
  echo "WARNING: Found rgba() values in component styles."
  echo "Consider using CSS variables for shadows and overlays."
  echo ""
  for file in $RGBA_COLORS; do
    echo "  - $file"
  done
  echo ""
fi

echo "Theme validation passed!"

# Run lint check if dependencies are installed
if [ -d "node_modules" ]; then
  echo "Running lint..."
  pnpm lint || exit 1
else
  echo "Skipping lint (node_modules not installed)"
fi

echo "Pre-commit checks passed!"
