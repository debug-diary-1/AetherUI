{
  "name": "aetherui",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write \"**/*.{ts,tsx,md}\"",
        "cwd": "."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'No linting for root project' && exit 0",
        "cwd": "."
      }
    }
  }
}