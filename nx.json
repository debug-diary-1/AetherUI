{
  "$schema": "https://nx.dev/schema",
  "affected": {
    "defaultBase": "main"
  },
  "parallel": 3,
  "cacheableOperations": ["build", "test", "lint", "typecheck"],
  "tasksRunnerOptions": {
    "default": {
      "runner": "@nx/workspace/tasks-runners/default",
      "options": {
        "cacheableOperations": ["build", "test", "lint", "typecheck"],
        "parallel": 3,
        "cacheDirectory": ".nx/cache",
        "useDaemonProcess": true
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/package.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
      "!{projectRoot}/.storybook/**/*",
      "!{projectRoot}/**/*.md"
    ],
    "linting": [
      "default",
      "{workspaceRoot}/.eslintrc.json",
      "{workspaceRoot}/.eslintignore",
      "{workspaceRoot}/eslint.config.js"
    ],
    "testing": [
      "default",
      "{workspaceRoot}/vitest.config.ts",
      "{workspaceRoot}/vitest.workspace.ts",
      "{projectRoot}/**/*.test.ts",
      "{projectRoot}/**/*.spec.ts"
    ],
    "styles": [
      "{projectRoot}/**/*.css",
      "{projectRoot}/**/*.scss",
      "{projectRoot}/src/**/styles.ts"
    ],
    "env": ["{workspaceRoot}/**/.env.*local"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "{projectRoot}/dist/**",
        "{projectRoot}/.next/**"
      ],
      "inputs": ["production", "^production", "env"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": true,
      "inputs": ["linting"]
    },
    "test": {
      "outputs": ["{projectRoot}/coverage/**"],
      "inputs": ["testing"],
      "dependsOn": [],
      "cache": true,
      "options": {
        "passWithNoTests": true
      }
    },
    "test:memory": {
      "outputs": ["{projectRoot}/coverage/**"],
      "inputs": [
        "{projectRoot}/src/**/*.tsx",
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/test/**/*.ts",
        "{projectRoot}/test/**/*.tsx"
      ],
      "dependsOn": [],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "NODE_OPTIONS=--max-old-space-size=512 MEMORY_OPTIMIZED=true vitest run"
      }
    },
    "test:api": {
      "outputs": ["{projectRoot}/coverage/**"],
      "inputs": [
        "{projectRoot}/src/**/*.tsx",
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/test/**/*.ts",
        "{projectRoot}/test/**/*.tsx"
      ],
      "dependsOn": [],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "NODE_OPTIONS=--max-old-space-size=512 MEMORY_OPTIMIZED=true vitest run \"**/*api*.test.ts\""
      }
    },
    "clean": { "cache": false },
    "perf": { "dependsOn": ["build"], "outputs": [], "cache": false, "options": { "CI": "true" } },
    "storybook": { "dependsOn": ["^build"], "cache": false, "persistent": true },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/storybook-static/**"]
    },
    "docs": { "dependsOn": ["^build"], "cache": false, "persistent": true },
    "docs:build": { "dependsOn": ["^build"], "outputs": ["{projectRoot}/dist/**"] }
  },
  "nxCloud": {
    "organization": "MpAIVrTJI3"
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": { "targetName": "typecheck" },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "vite:build",
        "testTargetName": "vite:test",
        "serveTargetName": "serve",
        "devTargetName": "vite:dev",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "vite:typecheck",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    }
  ],
  "nxCloudId": "6860442d84a5265f9cd1075e"
}