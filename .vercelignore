# .vercelignore
# Ignore files and directories from Vercel deployments

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
.next/
.turbo/

# Testing
coverage/
.nyc_output/

# Misc
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# OS
Thumbs.db

# Environment
.env
.env.local
.env*.local

# Keep storybook-static for deployment
!packages/storybook/storybook-static/
