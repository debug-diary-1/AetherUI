{
  "name": "@aetherui/accordion",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/accordion/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "vite build",
        "cwd": "packages/accordion"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src --ext .ts",
        "cwd": "packages/accordion"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'No tests configured' && exit 0",
        "cwd": "packages/accordion"
      }
    },
    "test:memory": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS=--max-old-space-size=512 vitest run --no-workspace --config ../../vitest.memory.config.js",
        "cwd": "packages/accordion"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rimraf dist",
        "cwd": "packages/accordion"
      }
    }
  },
  "tags": [
    "components",
    "accordion"
  ]
}
