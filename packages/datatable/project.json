{
  "name": "@aetherui/datatable",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/datatable/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "vite build",
        "cwd": "packages/datatable"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src --ext .ts",
        "cwd": "packages/datatable"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "configFile": "packages/datatable/vitest.config.ts",
        "passWithNoTests": true
      }
    },
    "test:memory": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS=--max-old-space-size=512 vitest run --no-workspace --config ../../vitest.memory.config.js",
        "cwd": "packages/datatable"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rimraf dist",
        "cwd": "packages/datatable"
      }
    }
  },
  "tags": [
    "datatable"
  ]
}
