{
  "name": "@aetherui/core",
  "version": "0.1.0",
  "description": "Headless, framework-agnostic Web Component library built with Lit",
  "keywords": [
    "accessibility",
    "aetherui",
    "component-library",
    "headless-ui",
    "lit",
    "typescript",
    "web-components"
  ],
  "homepage": "https://github.com/debug-diary-1/AetherUI#readme",
  "bugs": {
    "url": "https://github.com/debug-diary-1/AetherUI/issues"
  },
  "license": "MIT",
  "author": "AetherUI Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debug-diary-1/AetherUI.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "custom-elements.json",
    "component-catalog.json",
    "react.d.ts"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./accordion": {
      "types": "./dist/accordion/index.d.ts",
      "import": "./dist/accordion/index.js",
      "require": "./dist/accordion/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js",
      "require": "./dist/button/index.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/index.d.ts",
      "import": "./dist/checkbox/index.js",
      "require": "./dist/checkbox/index.js"
    },
    "./dropdown": {
      "types": "./dist/dropdown/index.d.ts",
      "import": "./dist/dropdown/index.js",
      "require": "./dist/dropdown/index.js"
    },
    "./modal": {
      "types": "./dist/modal/index.d.ts",
      "import": "./dist/modal/index.js",
      "require": "./dist/modal/index.js"
    },
    "./radio": {
      "types": "./dist/radio/index.d.ts",
      "import": "./dist/radio/index.js",
      "require": "./dist/radio/index.js"
    },
    "./tabs": {
      "types": "./dist/tabs/index.d.ts",
      "import": "./dist/tabs/index.js",
      "require": "./dist/tabs/index.js"
    },
    "./treeview": {
      "types": "./dist/treeview/index.d.ts",
      "import": "./dist/treeview/index.js",
      "require": "./dist/treeview/index.js"
    },
    "./alert": {
      "types": "./dist/alert/index.d.ts",
      "import": "./dist/alert/index.js",
      "require": "./dist/alert/index.js"
    },
    "./combo": {
      "types": "./dist/combo/index.d.ts",
      "import": "./dist/combo/index.js",
      "require": "./dist/combo/index.js"
    },
    "./autocomplete": {
      "types": "./dist/autocomplete/index.d.ts",
      "import": "./dist/autocomplete/index.js",
      "require": "./dist/autocomplete/index.js"
    },
    "./toast": {
      "types": "./dist/toast/index.d.ts",
      "import": "./dist/toast/index.js",
      "require": "./dist/toast/index.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip/index.d.ts",
      "import": "./dist/tooltip/index.js",
      "require": "./dist/tooltip/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "import": "./dist/input/index.js",
      "require": "./dist/input/index.js"
    },
    "./select": {
      "types": "./dist/select/index.d.ts",
      "import": "./dist/select/index.js",
      "require": "./dist/select/index.js"
    },
    "./textarea": {
      "types": "./dist/textarea/index.d.ts",
      "import": "./dist/textarea/index.js",
      "require": "./dist/textarea/index.js"
    },
    "./badge": {
      "types": "./dist/badge/index.d.ts",
      "import": "./dist/badge/index.js",
      "require": "./dist/badge/index.js"
    },
    "./spinner": {
      "types": "./dist/spinner/index.d.ts",
      "import": "./dist/spinner/index.js",
      "require": "./dist/spinner/index.js"
    },
    "./switch": {
      "types": "./dist/switch/index.d.ts",
      "import": "./dist/switch/index.js",
      "require": "./dist/switch/index.js"
    },
    "./progress": {
      "types": "./dist/progress/index.d.ts",
      "import": "./dist/progress/index.js",
      "require": "./dist/progress/index.js"
    },
    "./breadcrumb": {
      "types": "./dist/breadcrumb/index.d.ts",
      "import": "./dist/breadcrumb/index.js",
      "require": "./dist/breadcrumb/index.js"
    },
    "./pagination": {
      "types": "./dist/pagination/index.d.ts",
      "import": "./dist/pagination/index.js",
      "require": "./dist/pagination/index.js"
    },
    "./drawer": {
      "types": "./dist/drawer/index.d.ts",
      "import": "./dist/drawer/index.js",
      "require": "./dist/drawer/index.js"
    },
    "./popover": {
      "types": "./dist/popover/index.d.ts",
      "import": "./dist/popover/index.js",
      "require": "./dist/popover/index.js"
    },
    "./menu": {
      "types": "./dist/menu/index.d.ts",
      "import": "./dist/menu/index.js",
      "require": "./dist/menu/index.js"
    },
    "./react": {
      "types": "./react.d.ts"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./component-catalog.json": "./component-catalog.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm analyze && pnpm gen:react-types && vite build",
    "analyze": "cem analyze --litelement --globs 'src/**/ae-*.ts'",
    "gen:react-types": "node ../../scripts/generate-react-types.mjs",
    "gen:agent-artifacts": "pnpm analyze && node ../../scripts/generate-agent-artifacts.mjs",
    "dev": "vite",
    "clean": "rimraf dist",
    "lint": "oxlint src",
    "test": "web-test-runner --config web-test-runner.config.mjs",
    "test:coverage": "COVERAGE=true web-test-runner --config web-test-runner.config.mjs",
    "test:cross-browser": "CROSS_BROWSER=true web-test-runner --config web-test-runner.config.mjs",
    "test:watch": "web-test-runner --watch",
    "typecheck:react": "tsc -p tsconfig.react.json"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "lit": "catalog:"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "catalog:",
    "@open-wc/testing": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "19.2.18",
    "@typescript/native": "catalog:",
    "@web/test-runner-playwright": "catalog:",
    "playwright": "catalog:",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "unplugin-dts": "catalog:",
    "vite": "catalog:"
  },
  "customElements": "custom-elements.json"
}
