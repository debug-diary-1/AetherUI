{
  "name": "@aetherui/core",
  "version": "0.1.0",
  "description": "Headless, framework-agnostic Web Component library built with Lit",
  "author": "AetherUI Contributors",
  "license": "MIT",
  "homepage": "https://github.com/pallavL01/AetherUI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pallavL01/AetherUI.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/pallavL01/AetherUI/issues"
  },
  "keywords": [
    "web-components",
    "lit",
    "headless-ui",
    "component-library",
    "aetherui",
    "typescript",
    "accessibility"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./auto-register": {
      "import": "./dist/auto-register.js",
      "require": "./dist/auto-register.js",
      "types": "./dist/auto-register.d.ts"
    },
    "./accordion": {
      "types": "./dist/accordion/index.d.ts",
      "import": "./dist/accordion/index.js",
      "require": "./dist/accordion/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js",
      "require": "./dist/button/index.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/index.d.ts",
      "import": "./dist/checkbox/index.js",
      "require": "./dist/checkbox/index.js"
    },
    "./dropdown": {
      "types": "./dist/dropdown/index.d.ts",
      "import": "./dist/dropdown/index.js",
      "require": "./dist/dropdown/index.js"
    },
    "./modal": {
      "types": "./dist/modal/index.d.ts",
      "import": "./dist/modal/index.js",
      "require": "./dist/modal/index.js"
    },
    "./radio": {
      "types": "./dist/radio/index.d.ts",
      "import": "./dist/radio/index.js",
      "require": "./dist/radio/index.js"
    },
    "./tabs": {
      "types": "./dist/tabs/index.d.ts",
      "import": "./dist/tabs/index.js",
      "require": "./dist/tabs/index.js"
    },
    "./treeview": {
      "types": "./dist/treeview/index.d.ts",
      "import": "./dist/treeview/index.js",
      "require": "./dist/treeview/index.js"
    },
    "./alert": {
      "types": "./dist/alert/index.d.ts",
      "import": "./dist/alert/index.js",
      "require": "./dist/alert/index.js"
    },
    "./combo": {
      "types": "./dist/combo/index.d.ts",
      "import": "./dist/combo/index.js",
      "require": "./dist/combo/index.js"
    },
    "./autocomplete": {
      "types": "./dist/autocomplete/index.d.ts",
      "import": "./dist/autocomplete/index.js",
      "require": "./dist/autocomplete/index.js"
    },
    "./toast": {
      "types": "./dist/toast/index.d.ts",
      "import": "./dist/toast/index.js",
      "require": "./dist/toast/index.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip/index.d.ts",
      "import": "./dist/tooltip/index.js",
      "require": "./dist/tooltip/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "require": "./dist/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "test": "pnpm test:api && pnpm test:wc",
    "test:wc": "web-test-runner",
    "test:wc:watch": "web-test-runner --watch",
    "test:wc:vitest": "vitest run --config vitest.wc.config.ts",
    "test:wc:vitest:watch": "vitest watch --config vitest.wc.config.ts",
    "test:api": "vitest run src/**/__tests__/api.test.ts",
    "test:unit": "vitest run --exclude \"src/**/__tests__/*.test.ts\"",
    "test:unit:watch": "vitest watch --exclude \"src/**/__tests__/*.test.ts\"",
    "test:memory": "NODE_OPTIONS=--max-old-space-size=512 vitest run --exclude \"src/**/__tests__/*.test.ts\""
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.0",
    "lit": "^3.0.0",
    "lit-modal-portal": "^0.6.0"
  },
  "devDependencies": {
    "@open-wc/testing": "^3.2.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0"
  }
}