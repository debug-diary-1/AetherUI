{
  "name": "@aetherui/core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/core/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "outputPath": "packages/core/dist",
        "configFile": "packages/core/vite.config.ts"
      },
      "configurations": {
        "production": {
          "sourcemap": false,
          "minify": true
        },
        "development": {
          "sourcemap": true,
          "minify": false
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/core/src/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "configFile": "packages/core/vitest.config.ts",
        "passWithNoTests": true
      }
    },
    "test:memory": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS=--max-old-space-size=512 MEMORY_OPTIMIZED=true vitest run",
        "cwd": "packages/core"
      }
    },
    "test:api": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS=--max-old-space-size=512 MEMORY_OPTIMIZED=true vitest run \"**/*api*.test.ts\"",
        "cwd": "packages/core"
      }
    },
    "test:wc:vitest": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS=--max-old-space-size=512 vitest run --config vitest.wc.config.ts",
        "cwd": "packages/core"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rimraf dist",
        "cwd": "packages/core"
      }
    }
  },
  "tags": [
    "core"
  ]
}
