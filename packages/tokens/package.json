{
  "name": "@aetherui/tokens",
  "version": "0.1.0",
  "description": "Design tokens for AetherUI components",
  "author": "AetherUI Contributors",
  "license": "MIT",
  "homepage": "https://github.com/pallavL01/AetherUI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pallavL01/AetherUI.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/pallavL01/AetherUI/issues"
  },
  "keywords": [
    "design-tokens",
    "css-variables",
    "theming",
    "aetherui"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./light.css": {
      "import": "./dist/light.css"
    },
    "./dark.css": {
      "import": "./dist/dark.css"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "test": "echo 'No tests yet'"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "vite": "^6.3.6",
    "vite-plugin-dts": "^4.0.0",
    "rimraf": "^6.1.2",
    "typescript": "^5.0.0"
  }
} 