{
  "name": "@aetherui/tokens",
  "version": "0.1.0",
  "description": "Design tokens for AetherUI components",
  "keywords": [
    "aetherui",
    "css-variables",
    "design-tokens",
    "theming"
  ],
  "homepage": "https://github.com/debug-diary-1/AetherUI#readme",
  "bugs": {
    "url": "https://github.com/debug-diary-1/AetherUI/issues"
  },
  "license": "MIT",
  "author": "AetherUI Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debug-diary-1/AetherUI.git",
    "directory": "packages/tokens"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./light.css": {
      "import": "./dist/light.css"
    },
    "./dark.css": {
      "import": "./dist/dark.css"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rimraf dist",
    "lint": "oxlint src test",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  }
}
