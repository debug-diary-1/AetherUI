{
  "name": "@aetherui/polyfills",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/polyfills/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "outputPath": "packages/polyfills/dist",
        "configFile": "packages/polyfills/vite.config.ts"
      },
      "configurations": {
        "production": {
          "sourcemap": false,
          "minify": true
        },
        "development": {
          "sourcemap": true,
          "minify": false
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src --ext .ts",
        "cwd": "packages/polyfills"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/polyfills"
      }
    },
    "test:memory": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS=--max-old-space-size=512 vitest run --no-workspace --config ../../vitest.memory.config.js",
        "cwd": "packages/polyfills"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rimraf dist",
        "cwd": "packages/polyfills"
      }
    }
  },
  "tags": [
    "polyfills"
  ]
}
