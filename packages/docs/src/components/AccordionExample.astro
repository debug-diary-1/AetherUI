---
import { Code } from '@astrojs/starlight/components';

interface Props {
  code?: string;
  preview?: string;
}

const { code, preview } = Astro.props;
---

<div class="accordion-example">
  {preview ? <div set:html={preview} /> : <slot />}
</div>

{code && (
  <div class="code-preview">
    <Code language="html" code={code} />
  </div>
)}

<script>
  import { defineAeAccordion } from '@aetherui/core';
  
  // Register accordion components
  defineAeAccordion();
</script>

<style>
  .accordion-example {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem 0;
  }

  :global(ae-accordion) {
    width: 100%;
  }
</style>
