---
interface Props {
  data?: {
    hero?: {
      title?: string;
      tagline?: string;
      actions?: Array<{
        text: string;
        link: string;
        variant?: 'primary' | 'secondary';
      }>;
    };
  };
}

const { data } = Astro.props;
const { title, tagline, actions = [] } = data?.hero || {};
---

{(title || tagline || actions.length > 0) && (
  <div class="hero">
    <div class="hero-content">
      {title && <h1 class="title">{title}</h1>}
      {tagline && <div class="tagline" set:html={tagline} />}
      {actions.length > 0 && (
        <div class="actions">
          {actions.map(({ text, link, variant = 'primary' }) => (
            <a href={link} class:list={['action', variant]}>
              {text}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
)}

<style>
  .hero {
    padding: 3rem 0;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .hero-content {
    max-width: 600px;
  }

  .title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 1rem 0;
    color: var(--sl-color-text);
  }

  .tagline {
    font-size: 1.25rem;
    line-height: 1.5;
    margin-bottom: 2rem;
    color: var(--sl-color-gray-2);
  }

  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .action {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 0.375rem;
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.2s;
  }

  .action:hover {
    opacity: 0.85;
  }

  .action.primary {
    background: var(--sl-color-accent);
    color: white;
  }

  .action.secondary {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text);
    border: 1px solid var(--sl-color-gray-5);
  }

  @media (max-width: 768px) {
    .title {
      font-size: 2rem;
    }

    .tagline {
      font-size: 1.125rem;
    }
  }
</style>