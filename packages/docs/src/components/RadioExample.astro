---
import { Code } from '@astrojs/starlight/components';

interface Props {
  code?: string;
  preview?: string;
}

const { code, preview } = Astro.props;

// Ensure preview HTML is properly escaped for template literals
const sanitizedPreview = preview?.replace(/\${/g, '\\${');
---

<div class="radio-example">
  <div class="preview">
    {sanitizedPreview ? <div set:html={sanitizedPreview} /> : <slot />}
  </div>
  {code && (
    <div class="code-preview">
      <Code code={code} lang="html" />
    </div>
  )}
</div>

<!-- Components are registered globally via Head.astro -->


<style>
  .radio-example {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    border-radius: 0.5rem;
    background: var(--sl-color-gray-1);
  }

  .preview {
    padding: 1.5rem;
    border-radius: 0.25rem;
    background: #ffffff;
    position: relative;
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  /* Light mode styles */
  :global(.preview ae-radio-group) {
    width: 100%;
    display: flex;
    gap: 1rem;
  }

  /* Horizontal orientation styles */
  :global(.preview ae-radio-group[orientation="horizontal"]) {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 2.5rem;
    padding: 0.5rem 0;
  }

  /* Custom radio styling using parts */
  :global(.preview ae-radio) {
    --ae-radio-size: 1.25rem;
    --ae-radio-border-color: #94a3b8;
    --ae-radio-bg: #ffffff;
    --ae-radio-checked-border-color: #3b82f6;
    --ae-radio-checked-bg: #3b82f6;
    --ae-radio-indicator-color: #ffffff;
    --ae-radio-text-color: #1e293b;
    --ae-radio-focus-ring-color: #3b82f6;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-width: max-content;
  }

  :global(.preview ae-radio::part(control)) {
    width: 1.25rem;
    height: 1.25rem;
    border-width: 2px;
    transition: all 200ms ease;
    flex-shrink: 0;
  }

  :global(.preview ae-radio::part(indicator)) {
    background: #3b82f6;
    transition: transform 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.preview ae-radio::part(label)) {
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: #1e293b;
  }

  :global(.preview ae-radio:hover::part(control)) {
    border-color: #3b82f6;
    transform: scale(1.05);
  }

  /* Dark mode styles */
  :global([data-theme="dark"] .preview) {
    background: #1e293b;
  }

  :global([data-theme="dark"] .preview ae-radio) {
    --ae-radio-border-color: #64748b;
    --ae-radio-bg: #334155;
    --ae-radio-checked-border-color: #60a5fa;
    --ae-radio-checked-bg: #3b82f6;
    --ae-radio-text-color: #f1f5f9;
  }

  :global([data-theme="dark"] .preview ae-radio::part(label)) {
    color: #f1f5f9;
  }

  :global([data-theme="dark"] .preview ae-radio::part(indicator)) {
    background: #60a5fa;
  }

  :global([data-theme="dark"] .preview ae-radio:hover::part(control)) {
    border-color: #60a5fa;
  }
</style> 