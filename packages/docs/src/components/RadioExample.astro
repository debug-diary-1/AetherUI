---
import { Code } from '@astrojs/starlight/components';

interface Props {
  code?: string;
  preview?: string;
}

const { code, preview } = Astro.props;

// Ensure preview HTML is properly escaped for template literals
const sanitizedPreview = preview?.replace(/\${/g, '\\${');
---

<div class="radio-example">
  <div class="preview">
    {sanitizedPreview ? <div set:html={sanitizedPreview} /> : <slot />}
  </div>
  {code && (
    <div class="code-preview">
      <Code code={code} lang="html" />
    </div>
  )}
</div>


<style>
  .radio-example {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    border-radius: 0.5rem;
    background: var(--sl-color-gray-1);
  }

  .preview {
    padding: 1.5rem;
    border-radius: 0.25rem;
    background: var(--sl-color-white);
    position: relative;
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  /* Light mode styles */
  :global(.preview ae-radio-group) {
    width: 100%;
    --ae-color-border: var(--sl-color-gray-4);
    --ae-color-surface: var(--sl-color-white);
    --ae-color-primary: var(--sl-color-accent);
    --ae-color-text: var(--sl-color-text);
    --ae-font-size-sm: 1rem;
    display: flex;
    gap: 1rem;
  }

  /* Horizontal orientation styles */
  :global(.preview ae-radio-group[orientation="horizontal"]) {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 2.5rem;
    padding: 0.5rem 0;
  }

  /* Custom radio styling using parts */
  :global(.preview ae-radio) {
    --ae-radio-text-color: var(--sl-color-text);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-width: max-content;
  }

  :global(.preview ae-radio::part(control)) {
    width: 1.25rem;
    height: 1.25rem;
    border-width: 2px;
    transition: all 200ms ease;
    flex-shrink: 0;
  }

  :global(.preview ae-radio::part(indicator)) {
    background: var(--sl-color-accent);
    transition: transform 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.preview ae-radio::part(label)) {
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--sl-color-text);
  }

  :global(.preview ae-radio:hover::part(control)) {
    border-color: var(--sl-color-accent);
    transform: scale(1.05);
  }

  /* Dark mode styles */
  :global([data-theme="dark"] .preview) {
    background: var(--sl-color-gray-6);
  }

  :global([data-theme="dark"] .preview ae-radio-group) {
    --ae-color-border: var(--sl-color-gray-5);
    --ae-color-surface: var(--sl-color-gray-7);
    --ae-color-primary: var(--sl-color-accent-high);
    --ae-color-text: var(--sl-color-gray-1);
  }

  :global([data-theme="dark"] .preview ae-radio::part(indicator)) {
    background: var(--sl-color-accent-high);
  }

  :global([data-theme="dark"] .preview ae-radio:hover::part(control)) {
    border-color: var(--sl-color-accent-high);
  }
</style> 