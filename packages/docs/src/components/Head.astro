---
// Override Starlight's Head component to add our setup script
import Default from '@astrojs/starlight/components/Head.astro';

const props = Astro.props;
---

<Default {...props} />
<script>
  // On-demand component registration script
  import('../scripts/setup-components.ts');
  
  // Preload commonly used submodules to speed up first interaction
  // Note: kept tiny; these are separate chunks
  import('@aetherui/core/button');
  import('@aetherui/core/checkbox');
</script>