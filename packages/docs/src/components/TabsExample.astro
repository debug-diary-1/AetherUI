---
interface Props {
  code: string;
  preview?: string;
  title?: string;
  description?: string;
}

const { code, preview, title, description } = Astro.props;
---

<div class="interactive-example">
  {title && <h3 class="title">{title}</h3>}
  {description && <p class="description">{description}</p>}
  <div class="preview">
    <Fragment set:html={preview || code} />
  </div>
  <div class="code">
    <pre><code class="language-html">{code}</code></pre>
  </div>
</div>

<style>
  .interactive-example {
    border: 1px solid var(--sl-color-border);
    border-radius: 0.5rem;
    margin: 1.5rem 0;
    overflow: hidden;
  }

  .title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    padding: 1rem;
    border-bottom: 1px solid var(--sl-color-border);
  }

  .description {
    margin: 0;
    padding: 0 1rem 1rem;
    color: var(--sl-color-text-light);
    font-size: 0.9rem;
    border-bottom: 1px solid var(--sl-color-border);
  }

  .preview {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 1rem;
    background: var(--sl-color-bg);
  }

  .code {
    border-top: 1px solid var(--sl-color-border);
    background: var(--sl-color-bg-sidebar);
    padding: 1rem;
    margin: 0;
  }

  .code pre {
    margin: 0;
    padding: 0;
  }

  :global(.dark) .preview {
    background: var(--sl-color-black);
  }
   
  /* Basic styling for example container */
  .preview {
    contain: content;
  }
  
  /* Just margin for the tabs component */
  .preview ae-tabs {
    margin-bottom: 1rem;
  }
</style>

<!-- Register Tabs elements only -->
<script>
  // Lazy-load just the tabs module and register elements
  import('@aetherui/core/tabs').then((m) => {
    if (m.defineAeTabs) m.defineAeTabs();
  });
  
  // Make sure orientation attributes are correctly set
  document.addEventListener('DOMContentLoaded', () => {
    // Wait for components to be defined and attached
    setTimeout(() => {
      // For each ae-tabs element...
      document.querySelectorAll('ae-tabs').forEach(tabElement => {
        // Ensure orientation attribute is explicitly set
        const isVertical = tabElement.getAttribute('orientation') === 'vertical';
        
        if (isVertical) {
          tabElement.setAttribute('orientation', 'vertical');
        } else {
          tabElement.setAttribute('orientation', 'horizontal');
        }
      });
    }, 100);
  });
</script>
