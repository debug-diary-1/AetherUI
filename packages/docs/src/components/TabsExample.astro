---
interface Props {
  code: string;
  preview?: string;
  title?: string;
  description?: string;
}

const { code, preview, title, description } = Astro.props;
---

<div class="interactive-example">
  {title && <h3 class="title">{title}</h3>}
  {description && <p class="description">{description}</p>}
  <div class="preview">
    <Fragment set:html={preview || code} />
  </div>
  <div class="code">
    <pre><code class="language-html">{code}</code></pre>
  </div>
</div>

<style>
  .interactive-example {
    border: 1px solid var(--sl-color-border);
    border-radius: 0.5rem;
    margin: 1.5rem 0;
    overflow: hidden;
  }

  .title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    padding: 1rem;
    border-bottom: 1px solid var(--sl-color-border);
  }

  .description {
    margin: 0;
    padding: 0 1rem 1rem;
    color: var(--sl-color-text-light);
    font-size: 0.9rem;
    border-bottom: 1px solid var(--sl-color-border);
  }

  .preview {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 1rem;
    background: var(--sl-color-bg);
  }

  .code {
    border-top: 1px solid var(--sl-color-border);
    background: var(--sl-color-bg-sidebar);
    padding: 1rem;
    margin: 0;
  }

  .code pre {
    margin: 0;
    padding: 0;
  }

  :global(.dark) .preview {
    background: var(--sl-color-black);
  }
   
  /* Force horizontal orientation by default */
  :global(ae-tabs:not([orientation="vertical"])) {
    display: block !important;
  }

  :global(ae-tabs:not([orientation="vertical"])) :global([part="tablist"]) {
    flex-direction: row !important;
    border-bottom: 1px solid #ddd !important;
    border-right: none !important;
    margin-bottom: 1rem !important;
    margin-right: 0 !important;
  }
</style>

<!-- Register custom elements client-side -->
<script>
  // Import happens at runtime in the browser
  import { defineAll } from '@aetherui/core';
  
  // Initialize all components
  defineAll();
  
  // Fix orientation of tabs after components are loaded
  document.addEventListener('DOMContentLoaded', () => {
    // Select all tabs without a vertical orientation
    const horizontalTabs = document.querySelectorAll('ae-tabs:not([orientation="vertical"])');
    
    // Set horizontal orientation explicitly
    horizontalTabs.forEach(tab => {
      tab.setAttribute('orientation', 'horizontal');
    });
  });
</script>
