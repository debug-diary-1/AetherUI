---
import { Code } from '@astrojs/starlight/components';

interface Props {
  code?: string;
  preview?: string;
  title?: string;
  description?: string;
  class?: string;
}

const { code, preview, title, description, class: className } = Astro.props;
---

<div class={`component-example ${className || ''}`}>
  {title && <h3 class="example-title">{title}</h3>}
  {description && <p class="example-description">{description}</p>}
  {preview ? (
    <div class="preview" data-preview={preview}>
      <!-- Preview will be injected by client-side script -->
    </div>
  ) : (
    <div class="preview">
      <slot />
    </div>
  )}
  {code && (
    <div class="code-preview">
      <Code code={code} lang="html" />
    </div>
  )}
</div>

<script>
  // Components are registered globally via Head.astro
  // This script handles preview injection after components are ready

  // Inject HTML after components are ready
  function injectPreviews() {
    const previews = document.querySelectorAll('[data-preview]');
    previews.forEach(preview => {
      const html = preview.getAttribute('data-preview');
      if (html) {
        preview.innerHTML = html;
        preview.removeAttribute('data-preview');
      }
    });
  }
  
  // Wait for components to be ready
  const checkAndInject = () => {
    // Check if at least one custom element is defined
    const isDefined = ['ae-button', 'ae-checkbox', 'ae-radio', 'ae-treeview', 'ae-toast', 'ae-tooltip']
      .some(tag => window.customElements.get(tag) !== undefined);
    
    if (isDefined) {
      injectPreviews();
    } else {
      // Try again in a moment
      setTimeout(checkAndInject, 50);
    }
  };
  
  checkAndInject();
  
  // Re-inject on page navigation
  document.addEventListener('astro:page-load', () => {
    setTimeout(injectPreviews, 50);
  });
</script>

<style>
  .component-example {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    margin-bottom: 2rem;
    border-radius: 0.5rem;
    background: var(--sl-color-gray-1);
  }

  .example-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0;
    color: var(--sl-color-gray-9);
  }

  .example-description {
    font-size: 0.9rem;
    color: var(--sl-color-text-light);
    margin: 0 0 0.5rem 0;
  }

  .preview {
    padding: 1.5rem;
    border-radius: 0.25rem;
    background: var(--sl-color-white);
    position: relative;
    min-height: 60px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Dark mode styles */
  :global([data-theme="dark"]) .preview {
    background: var(--sl-color-gray-6);
  }

  :global([data-theme="dark"]) .example-title {
    color: var(--sl-color-gray-1);
  }

  /* Common layout helpers */
  :global(.preview .demo-row) {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }

  :global(.preview .demo-column) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }
</style>