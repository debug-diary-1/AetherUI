---
import { Code } from '@astrojs/starlight/components';

interface Props {
  code?: string;
  preview?: string;
  title?: string;
  description?: string;
}

const { code, preview, title, description } = Astro.props;
const exampleId = `button-example-${Math.random().toString(36).slice(2, 10)}`;
---

<div class="button-example" id={exampleId}>
  {title && <h3 class="example-title">{title}</h3>}
  {description && <p class="example-description">{description}</p>}
  
  <div class="preview">
    {preview ? <div set:html={preview} /> : code ? <div set:html={code} /> : <slot />}
  </div>
  
  {code && (
    <div class="code-preview">
      <Code code={code} lang="html" />
    </div>
  )}
</div>

<script>
  // Register only the button element
  import('@aetherui/core/button').then((m) => {
    if (m.defineAeButton) m.defineAeButton();
  });
  
  // Set up event listeners for initializing the layout
  document.addEventListener('DOMContentLoaded', applyLayoutStyles);
  document.addEventListener('astro:page-load', applyLayoutStyles);
  
  function applyLayoutStyles() {
    // Only apply layout styles, not component styles
    const styleEl = document.createElement('style');
    styleEl.textContent = `
      /* Layout styles for button examples */
      .button-group {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin: 0.5rem 0;
      }
      
      .button-group--vertical {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }
    `;
    document.head.appendChild(styleEl);
  }
</script>

<style>
  .button-example {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    margin-bottom: 2rem;
    border-radius: 0.5rem;
    background: var(--sl-color-gray-1);
  }

  .example-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0;
    color: var(--sl-color-gray-9);
  }
  
  .example-description {
    font-size: 0.9rem;
    color: var(--sl-color-text-light);
    margin: 0 0 0.5rem 0;
  }

  .preview {
    padding: 1.5rem;
    border-radius: 0.25rem;
    background: var(--sl-color-white);
    position: relative;
    min-height: 100px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Dark mode styles */
  :global([data-theme="dark"] .preview) {
    background: var(--sl-color-gray-6);
  }

  :global([data-theme="dark"] .example-title) {
    color: var(--sl-color-gray-1);
  }
  
  :global([data-theme="dark"] .example-description) {
    color: var(--sl-color-text-light);
  }

  /* Button groups */
  :global(.preview .button-group) {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
    margin: 0.5rem 0;
  }

  :global(.preview .button-group--vertical) {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  
  :global(.button-group--vertical .button-group) {
    margin-bottom: 1rem;
  }
  
  :global(.variant-description) {
    margin-top: 1rem;
    padding: 1rem;
    background-color: var(--sl-color-gray-1);
    border-left: 3px solid var(--sl-color-accent);
    border-radius: 0.25rem;
  }
  
  :global([data-theme="dark"] .variant-description) {
    background-color: var(--sl-color-gray-5);
  }
</style>
