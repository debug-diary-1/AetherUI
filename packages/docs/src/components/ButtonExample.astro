---
import { Code } from '@astrojs/starlight/components';

interface Props {
  code?: string;
  preview?: string;
}

const { code, preview } = Astro.props;
---

<div class="button-example">
  {preview ? <div class="preview" set:html={preview} /> : <slot />}
  {code && (
    <div class="code-preview">
      <Code code={code} lang="html" />
    </div>
  )}
</div>

<script>
  import { defineAll } from '@aetherui/core';
  defineAll();
</script>

<style>
  .button-example {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    border-radius: 0.5rem;
    background: var(--sl-color-gray-1);
  }

  .preview {
    padding: 1.5rem;
    border-radius: 0.25rem;
    background: var(--sl-color-white);
    position: relative;
    min-height: 100px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Light mode styles */
  :global(.preview ae-button) {
    /* Primary variant - Use for main actions */
    --ae-color-primary: var(--sl-color-accent);
    --ae-color-primary-hover: var(--sl-color-accent-high);
    --ae-color-primary-foreground: var(--sl-color-white);
    
    /* Secondary variant - Use for secondary actions */
    --ae-color-secondary: var(--sl-color-gray-2);
    --ae-color-secondary-hover: var(--sl-color-gray-3);
    --ae-color-secondary-foreground: var(--sl-color-gray-9);
    
    /* Ghost variant - Use for subtle actions */
    --ae-color-ghost: transparent;
    --ae-color-ghost-hover: var(--sl-color-gray-2);
    --ae-color-ghost-foreground: var(--sl-color-gray-9);
    
    /* Focus ring styles */
    --ae-focus-ring-color: var(--sl-color-accent);
    --ae-focus-ring-width: 2px;
    --ae-focus-ring-offset: 2px;
    
    /* Common styles */
    --ae-border-radius: 0.375rem;
    --ae-transition-duration: 200ms;
    --ae-font-family: var(--sl-font);
    --ae-font-weight: 500;
  }

  /* Icon styles */
  :global(.preview ae-button::part(icon)) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
  }

  :global(.preview ae-button[icon-only]) {
    aspect-ratio: 1;
    padding: 0.5rem;
  }

  /* Dark mode styles */
  :global([data-theme="dark"] .preview) {
    background: var(--sl-color-gray-6);
  }

  :global([data-theme="dark"] .preview ae-button) {
    /* Primary variant */
    --ae-color-primary: var(--sl-color-accent);
    --ae-color-primary-hover: var(--sl-color-accent-high);
    --ae-color-primary-foreground: var(--sl-color-white);
    
    /* Secondary variant */
    --ae-color-secondary: var(--sl-color-gray-5);
    --ae-color-secondary-hover: var(--sl-color-gray-4);
    --ae-color-secondary-foreground: var(--sl-color-white);
    
    /* Ghost variant */
    --ae-color-ghost: transparent;
    --ae-color-ghost-hover: var(--sl-color-gray-5);
    --ae-color-ghost-foreground: var(--sl-color-white);

    /* Focus ring */
    --ae-focus-ring-color: var(--sl-color-accent-high);
  }

  /* Variant recommendations */
  :global(.preview .variant-description) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    border-radius: 0.375rem;
    background: var(--sl-color-gray-1);
    margin-top: 1rem;
    width: 100%;
  }

  :global(.preview .variant-description h3) {
    font-size: 0.875rem;
    font-weight: 600;
    margin: 0;
    color: var(--sl-color-gray-9);
  }

  :global(.preview .variant-description p) {
    font-size: 0.875rem;
    margin: 0;
    color: var(--sl-color-gray-7);
  }

  :global([data-theme="dark"] .preview .variant-description) {
    background: var(--sl-color-gray-7);
  }

  :global([data-theme="dark"] .preview .variant-description h3) {
    color: var(--sl-color-white);
  }

  :global([data-theme="dark"] .preview .variant-description p) {
    color: var(--sl-color-gray-2);
  }

  /* Button groups */
  :global(.preview .button-group) {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  :global(.preview .button-group--vertical) {
    flex-direction: column;
    align-items: stretch;
  }
</style>
