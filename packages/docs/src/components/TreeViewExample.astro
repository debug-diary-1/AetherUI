---
import { Code } from '@astrojs/starlight/components';

const fileExplorerData = [
  {
    id: 'src',
    label: 'src',
    children: [
      {
        id: 'components',
        label: 'components',
        children: [
          { id: 'button.js', label: 'button.js', icon: '📄' },
          { id: 'accordion.js', label: 'accordion.js', icon: '📄' }
        ]
      },
      { id: 'index.js', label: 'index.js', icon: '📄' }
    ]
  },
  {
    id: 'package.json',
    label: 'package.json',
    icon: '📄'
  }
];

const menuData = [
  {
    id: 'file',
    label: 'File',
    children: [
      { id: 'new', label: 'New File' },
      { id: 'open', label: 'Open...' },
      { id: 'save', label: 'Save' }
    ]
  },
  {
    id: 'edit',
    label: 'Edit',
    children: [
      { id: 'undo', label: 'Undo' },
      { id: 'redo', label: 'Redo' },
      { id: 'cut', label: 'Cut' },
      { id: 'copy', label: 'Copy' },
      { id: 'paste', label: 'Paste' }
    ]
  }
];
---

<div class="example-container">
  <div class="examples-grid">
    <div class="example-card">
      <h3>File Explorer</h3>
      <div class="example-preview">
        <ae-treeview id="file-explorer"></ae-treeview>
      </div>
    </div>

    <div class="example-card">
      <h3>Multi-Select</h3>
      <div class="example-preview">
        <ae-treeview id="multi-select" selection-mode="multiple"></ae-treeview>
      </div>
    </div>

    <div class="example-card">
      <h3>Menu Structure</h3>
      <div class="example-preview">
        <ae-treeview id="menu-structure"></ae-treeview>
      </div>
    </div>

    <div class="example-card">
      <h3>Empty State</h3>
      <div class="example-preview">
        <ae-treeview id="empty-state"></ae-treeview>
      </div>
    </div>
  </div>

  <div class="code-example">
    <h3>Example Code</h3>
    <Code code={`<ae-treeview data='[
  {
    "id": "src",
    "label": "src",
    "children": [
      {
        "id": "components",
        "label": "components",
        "children": [
          { "id": "button.js", "label": "button.js", "icon": "📄" }
        ]
      }
    ]
  }
]'></ae-treeview>`} lang="html" />
  </div>
</div>

<style>
  .example-container {
    margin: 2rem 0;
  }

  .examples-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .example-card {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 1rem;
  }

  .example-card h3 {
    margin: 0 0 1rem 0;
    font-size: 1.125rem;
  }

  .example-preview {
    min-height: 200px;
    background: var(--sl-color-bg-nav);
    padding: 1rem;
    border-radius: 0.25rem;
  }

  .code-example {
    margin-top: 2rem;
  }

  .code-example h3 {
    margin-bottom: 1rem;
  }
</style>

<script>
  import { defineAll } from '@aetherui/core';
  defineAll();

  // Initialize TreeView data when components are ready
  function initTreeViews() {
    const fileExplorerData = [
      {
        id: 'src',
        label: 'src',
        children: [
          {
            id: 'components',
            label: 'components',
            children: [
              { id: 'button.js', label: 'button.js', icon: '📄' },
              { id: 'accordion.js', label: 'accordion.js', icon: '📄' }
            ]
          },
          { id: 'index.js', label: 'index.js', icon: '📄' }
        ]
      },
      {
        id: 'package.json',
        label: 'package.json',
        icon: '📄'
      }
    ];

    const menuData = [
      {
        id: 'file',
        label: 'File',
        children: [
          { id: 'new', label: 'New File' },
          { id: 'open', label: 'Open...' },
          { id: 'save', label: 'Save' }
        ]
      },
      {
        id: 'edit',
        label: 'Edit',
        children: [
          { id: 'undo', label: 'Undo' },
          { id: 'redo', label: 'Redo' },
          { id: 'cut', label: 'Cut' },
          { id: 'copy', label: 'Copy' },
          { id: 'paste', label: 'Paste' }
        ]
      }
    ];

    // Set data for each TreeView by setting the data attribute
    const fileExplorer = document.getElementById('file-explorer');
    if (fileExplorer) fileExplorer.setAttribute('data', JSON.stringify(fileExplorerData));

    const multiSelect = document.getElementById('multi-select');
    if (multiSelect) multiSelect.setAttribute('data', JSON.stringify(fileExplorerData));

    const menuStructure = document.getElementById('menu-structure');
    if (menuStructure) menuStructure.setAttribute('data', JSON.stringify(menuData));

    const emptyState = document.getElementById('empty-state');
    if (emptyState) emptyState.setAttribute('data', JSON.stringify([]));
  }

  // Initialize when components are ready
  function waitAndInit() {
    if (window.customElements.get('ae-treeview')) {
      initTreeViews();
    } else {
      if (window.__aetherui_initialized) {
        setTimeout(waitAndInit, 50);
      } else {
        window.addEventListener('aetherui:ready', initTreeViews, { once: true });
      }
    }
  }
  
  waitAndInit();
  
  // Re-initialize after page navigation
  document.addEventListener('astro:page-load', () => {
    waitAndInit();
  });
</script>