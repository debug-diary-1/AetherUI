---

<div class="tooltip-test">
  <h3>Simple Tooltip Test</h3>
  <ae-tooltip text="This is a test tooltip">
    <button>Hover me</button>
  </ae-tooltip>
</div>

<style>
  .tooltip-test {
    padding: 2rem;
    text-align: center;
  }
  
  button {
    padding: 0.5rem 1rem;
    border-radius: 0.25rem;
    border: 1px solid #ccc;
    background: white;
    cursor: pointer;
  }
  
  button:hover {
    background-color: #f0f0f0;
  }
</style>

<script>
  // Import and test the tooltip component
  import('@aetherui/core').then(({ AeTooltip, defineAeTooltip }) => {
    console.log('Registering tooltip component');
    defineAeTooltip();
    
    // Test tooltip functionality after a delay
    setTimeout(() => {
      const tooltip = document.querySelector('ae-tooltip');
      console.log('Tooltip element:', tooltip);
      
      if (tooltip) {
        console.log('Tooltip properties:');
        console.log('- text:', tooltip.text);
        console.log('- open:', tooltip.open);
        console.log('- shadowRoot:', tooltip.shadowRoot);
        
        // Check if the component is properly initialized
        console.log('Component class:', tooltip.constructor.name);
        
        // Try to manually show the tooltip
        console.log('Testing manual show...');
        tooltip.show();
        
        setTimeout(() => {
          console.log('Tooltip open after show():', tooltip.open);
          
          // Test with property setting
          console.log('Testing open property setting...');
          tooltip.open = true;
          
          setTimeout(() => {
            console.log('Tooltip open after property set:', tooltip.open);
          }, 100);
        }, 100);
      }
    }, 500);
  });
</script>