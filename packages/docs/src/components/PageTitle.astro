---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<header class="page-title">
  <h1 class="title">{title}</h1>
  {description && <p class="description">{description}</p>}
</header>

<style>
  .page-title {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--sl-color-border);
  }

  .title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: var(--sl-color-text);
  }

  .description {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--sl-color-text);
    margin: 0;
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .title {
      font-size: 1.75rem;
    }

    .description {
      font-size: 1rem;
    }
  }
</style> 