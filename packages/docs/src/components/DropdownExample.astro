---
import { Code } from '@astrojs/starlight/components';

interface Props {
  code: string;
  preview?: string;
  title?: string;
  description?: string;
}

const { code, preview, title, description } = Astro.props;
---

<div class="interactive-example">
  {title && <h3 class="title">{title}</h3>}
  {description && <p class="description">{description}</p>}
  <div class="preview">
    <div set:html={preview || code} />
  </div>
  <div class="code">
    <pre><code class="language-html">{code}</code></pre>
  </div>
</div>

<style>
  .interactive-example {
    border: 1px solid var(--sl-color-border);
    border-radius: 0.5rem;
    margin: 1.5rem 0;
    overflow: hidden;
  }

  .title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    padding: 1rem;
    border-bottom: 1px solid var(--sl-color-border);
  }

  .description {
    margin: 0;
    padding: 0 1rem 1rem;
    color: var(--sl-color-text-light);
    font-size: 0.9rem;
    border-bottom: 1px solid var(--sl-color-border);
  }

  .preview {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center; /* Center dropdown examples */
    justify-content: center;
    gap: 1rem;
    background: var(--sl-color-bg);
    min-height: 150px; /* Increase height for dropdown to open */
    position: relative;  /* Needed for proper dropdown positioning */
    z-index: 5;  /* Ensure dropdowns appear above other elements */
    overflow: visible !important; /* Allow dropdown to overflow */
  }

  .code {
    border-top: 1px solid var(--sl-color-border);
    background: var(--sl-color-bg-sidebar);
    padding: 1rem;
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .code pre {
    margin: 0;
    padding: 0;
  }

  :global(.dark) .preview {
    background: var(--sl-color-black);
  }

  /* Dropdown-specific styles */
  :global(ae-dropdown) {
    position: relative;
    display: inline-block;
  }
  
  :global(ae-dropdown button) {
    padding: 0.5rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    background-color: var(--sl-color-gray-1);
    border-radius: 0.25rem;
    cursor: pointer;
    font-size: 0.9rem;
  }
  
  :global(.dark ae-dropdown button) {
    background-color: var(--sl-color-gray-6);
    border-color: var(--sl-color-gray-7);
    color: white;
  }
</style>

<!-- Register custom elements client-side -->
<script>
  // Register components when the component is mounted
  import { defineAeDropdown, defineAeButton } from '../components/AetherComponents';
  
  // Register the specific components we need
  defineAeDropdown();
  defineAeButton();
  
  // Wait for everything to be fully loaded
  window.addEventListener('DOMContentLoaded', () => {
    // Force open attribute on dropdowns with default-open
    document.querySelectorAll('ae-dropdown[default-open]').forEach(dropdown => {
      setTimeout(() => {
        dropdown.setAttribute('open', '');
      }, 500);
    });
  });
</script>

