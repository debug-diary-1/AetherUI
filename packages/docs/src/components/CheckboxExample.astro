---
import { Code } from '@astrojs/starlight/components';

interface Props {
  code?: string;
  preview?: string;
}

const { code, preview } = Astro.props;
---

<div class="checkbox-example">
  {preview ? <div class="preview" set:html={preview} /> : <slot />}
  {code && (
    <div class="code-preview">
      <Code code={code} lang="html" />
    </div>
  )}
</div>

<script>
  import { defineAll } from '@aetherui/core';
  defineAll();
</script>

<style>
  .checkbox-example {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    border-radius: 0.5rem;
    background: var(--sl-color-gray-1);
  }

  .preview {
    padding: 1.5rem;
    border-radius: 0.25rem;
    background: var(--sl-color-white);
    position: relative;
    min-height: 100px;
    display: flex;
    align-items: flex-start;
  }

  /* Light mode styles */
  :global(.preview ae-checkbox) {
    --ae-checkbox-size: 1rem;
    --ae-checkbox-border-color: var(--sl-color-gray-4);
    --ae-checkbox-bg: var(--sl-color-white);
    --ae-checkbox-checked-border-color: var(--sl-color-accent);
    --ae-checkbox-checked-bg: var(--sl-color-accent);
    --ae-checkbox-checked-icon-color: var(--sl-color-white);
    --ae-checkbox-indeterminate-border-color: var(--sl-color-accent);
    --ae-checkbox-indeterminate-bg: var(--sl-color-accent);
    --ae-checkbox-indeterminate-icon-color: var(--sl-color-white);
    --ae-checkbox-focus-ring-color: var(--sl-color-accent);
  }

  :global(.preview ae-checkbox::part(control)) {
    border-radius: 0.25rem;
  }

  /* Dark mode styles */
  :global([data-theme="dark"] .preview) {
    background: var(--sl-color-gray-6);
  }

  :global([data-theme="dark"] .preview ae-checkbox) {
    --ae-checkbox-border-color: var(--sl-color-gray-3);
    --ae-checkbox-bg: var(--sl-color-gray-7);
    --ae-checkbox-checked-border-color: var(--sl-color-accent);
    --ae-checkbox-checked-bg: var(--sl-color-accent);
    --ae-checkbox-indeterminate-border-color: var(--sl-color-accent);
    --ae-checkbox-indeterminate-bg: var(--sl-color-accent);
  }

  :global([data-theme="dark"] .preview ae-checkbox::part(label)) {
    color: var(--sl-color-white);
  }
</style> 