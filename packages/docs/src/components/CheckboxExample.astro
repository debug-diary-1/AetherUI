---
import { Code } from '@astrojs/starlight/components';

interface Props {
  code?: string;
  preview?: string;
}

const { code, preview } = Astro.props;
---

<div class="checkbox-example">
  <div class="preview">
    {preview ? <div set:html={preview} /> : <slot />}
  </div>
  {code && (
    <div class="code-preview">
      <Code code={code} lang="html" />
    </div>
  )}
</div>

<!-- Components are registered globally via Head.astro -->

<style>
  .checkbox-example {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    border-radius: 0.5rem;
    background: var(--sl-color-gray-1);
  }

  .preview {
    padding: 1.5rem;
    border-radius: 0.25rem;
    background: #ffffff;
    position: relative;
    min-height: 100px;
    display: flex;
    align-items: flex-start;
  }

  /* Light mode styles */
  :global(.preview ae-checkbox) {
    --ae-checkbox-size: 1.125rem;
    --ae-checkbox-border-color: #94a3b8;
    --ae-checkbox-bg: #ffffff;
    --ae-checkbox-checked-border-color: #3b82f6;
    --ae-checkbox-checked-bg: #3b82f6;
    --ae-checkbox-checked-icon-color: #ffffff;
    --ae-checkbox-indeterminate-border-color: #3b82f6;
    --ae-checkbox-indeterminate-bg: #3b82f6;
    --ae-checkbox-indeterminate-icon-color: #ffffff;
    --ae-checkbox-focus-ring-color: #3b82f6;
    --ae-checkbox-text-color: #1e293b;
    --ae-checkbox-disabled-text-color: #94a3b8;
    --ae-checkbox-disabled-border-color: #cbd5e1;
    --ae-checkbox-disabled-bg: #f1f5f9;
  }

  :global(.preview ae-checkbox::part(control)) {
    border-radius: 0.25rem;
  }

  :global(.preview ae-checkbox::part(label)) {
    color: #1e293b;
  }

  /* Dark mode styles */
  :global([data-theme="dark"] .preview) {
    background: #1e293b;
  }

  :global([data-theme="dark"] .preview ae-checkbox) {
    --ae-checkbox-border-color: #64748b;
    --ae-checkbox-bg: #334155;
    --ae-checkbox-checked-border-color: #60a5fa;
    --ae-checkbox-checked-bg: #3b82f6;
    --ae-checkbox-indeterminate-border-color: #60a5fa;
    --ae-checkbox-indeterminate-bg: #3b82f6;
    --ae-checkbox-text-color: #f1f5f9;
    --ae-checkbox-disabled-text-color: #64748b;
    --ae-checkbox-disabled-border-color: #475569;
    --ae-checkbox-disabled-bg: #1e293b;
  }

  :global([data-theme="dark"] .preview ae-checkbox::part(label)) {
    color: #f1f5f9;
  }
</style> 