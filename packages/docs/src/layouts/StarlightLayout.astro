---
import { ViewTransitions } from 'astro:transitions';

// Remove server-side registration since it's causing issues
// import { registerAetherComponents } from '../components/AetherComponents';
// registerAetherComponents();
---

<slot />
<ViewTransitions />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<script>
  // Direct client-side component registration
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      // Import the core package
      const core = await import('@aetherui/core');
      
      // Define all components
      if (typeof core.defineAll === 'function') {
        core.defineAll();
        console.log('Aether UI components registered on client');
      }
      
      // Explicitly define TreeView
      if (typeof core.defineAeTreeView === 'function') {
        core.defineAeTreeView();
        console.log('TreeView component registered');
      }
      
      // Initialize any TreeViews on the page
      document.querySelectorAll('ae-treeview').forEach(treeview => {
        if (treeview.hasAttribute('data')) {
          try {
            const dataValue = treeview.getAttribute('data');
            if (dataValue) {
              const data = JSON.parse(dataValue);
              console.log('Setting TreeView data:', data);
              // @ts-ignore: Property assignment
              treeview.data = data;
            }
          } catch (e) {
            console.error('Error parsing TreeView data:', e);
          }
        }
      });
      
    } catch (error) {
      console.error('Error registering components:', error);
    }
  });
</script>
