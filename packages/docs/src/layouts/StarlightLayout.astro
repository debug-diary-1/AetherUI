---
import { ViewTransitions } from 'astro:transitions';
---

<slot />
<ViewTransitions />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<script>
  // Register Aether UI components immediately
  (async () => {
    const { defineAll } = await import('@aetherui/core');
    defineAll();
    
    // Dispatch event to signal components are ready
    window.dispatchEvent(new CustomEvent('aetherui:ready'));
  })();
  
  // Re-register on page navigation (for ViewTransitions)
  document.addEventListener('astro:page-load', async () => {
    const { defineAll } = await import('@aetherui/core');
    defineAll();
  });
</script>