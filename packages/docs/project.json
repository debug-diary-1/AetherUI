{
  "name": "@aetherui/docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/docs/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "astro build",
        "cwd": "packages/docs"
      },
      "dependsOn": [
        "^build"
      ]
    },
    "docs:build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "astro build",
        "cwd": "packages/docs"
      },
      "dependsOn": [
        "^build"
      ]
    },
    "docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro dev",
        "cwd": "packages/docs"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro dev",
        "cwd": "packages/docs"
      }
    }
  },
  "tags": [
    "docs"
  ]
}
