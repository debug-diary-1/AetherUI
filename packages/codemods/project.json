{
  "name": "@aetherui/codemods",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/codemods/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "outputPath": "packages/codemods/dist",
        "configFile": "packages/codemods/vite.config.ts"
      },
      "configurations": {
        "production": {
          "sourcemap": false,
          "minify": true
        },
        "development": {
          "sourcemap": true,
          "minify": false
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src --ext .ts",
        "cwd": "packages/codemods"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "configFile": "packages/codemods/vitest.config.ts",
        "passWithNoTests": true
      }
    },
    "test:memory": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS=--max-old-space-size=512 vitest run --no-workspace --config ../../vitest.memory.config.js",
        "cwd": "packages/codemods"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rimraf dist",
        "cwd": "packages/codemods"
      }
    }
  },
  "tags": [
    "codemods"
  ]
}
