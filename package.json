{
  "name": "aetherui",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for AetherUI - A headless, framework-agnostic Web Component library",
  "homepage": "https://github.com/debug-diary-1/AetherUI#readme",
  "bugs": {
    "url": "https://github.com/debug-diary-1/AetherUI/issues"
  },
  "license": "MIT",
  "author": "AetherUI Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debug-diary-1/AetherUI.git"
  },
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=4096' turbo build --filter=!@aetherui/storybook",
    "dev": "turbo dev",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node scripts/check-test-env.js 'NODE_OPTIONS=\"--max-old-space-size=2048\" turbo test'",
    "test:coverage": "pnpm --filter @aetherui/core test:coverage",
    "test:cross-browser": "pnpm --filter @aetherui/core test:cross-browser",
    "test:memory": "turbo test:memory --concurrency=1",
    "test:e2e": "playwright test",
    "test:e2e:static": "CI=true concurrently -k -s first -n \"SB,E2E\" -c \"magenta,blue\" \"npx http-server storybook-static --port 6006 --silent\" \"node scripts/wait-tcp.js 6006 && playwright test\"",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:storybook": "test-storybook --config-dir packages/storybook/.storybook",
    "test:storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"pnpm build-storybook -- --quiet && npx http-server storybook-static --port 6006 --silent\" \"node scripts/wait-tcp.js 6006 && pnpm test:storybook\"",
    "clean": "turbo clean",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "generate:agent-artifacts": "node scripts/generate-agent-artifacts.mjs",
    "check:agent-artifacts": "node scripts/generate-agent-artifacts.mjs --check",
    "test:agent-evals": "pnpm --filter @aetherui/agent build && node scripts/run-agent-evals.mjs",
    "pack:check": "node scripts/check-packages.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:agent-artifacts && pnpm test:agent-evals && pnpm pack:check",
    "check:release": "pnpm check && pnpm audit:prod && pnpm test:coverage && pnpm test:cross-browser && pnpm build-storybook && pnpm test:e2e:static",
    "prepare": "husky",
    "storybook": "turbo storybook --filter=@aetherui/storybook",
    "build-storybook": "turbo build-storybook --filter=@aetherui/storybook",
    "chromatic": "chromatic --exit-zero-on-changes --storybook-build-dir storybook-static",
    "build-preview": "bash scripts/build-preview.sh",
    "docs": "turbo docs",
    "docs:dev": "turbo dev --filter=@aetherui/docs",
    "docs:build": "NODE_OPTIONS='--max-old-space-size=4096' turbo docs:build",
    "deploy:docs": "pnpm docs:build && pnpm run docs:deploy",
    "docs:deploy": "touch packages/docs/dist/.nojekyll && pnpm run docs:push-gh-pages",
    "docs:push-gh-pages": "git checkout gh-pages && git pull && rm -rf docs && cp -r packages/docs/dist docs && git add docs && git commit -m \"Update docs\" && git push && git checkout -"
  },
  "devDependencies": {
    "@open-wc/testing": "catalog:",
    "@playwright/test": "catalog:",
    "@storybook/test-runner": "catalog:",
    "@types/node": "catalog:",
    "@web/dev-server-esbuild": "catalog:",
    "@web/test-runner": "catalog:",
    "@web/test-runner-playwright": "catalog:",
    "chromatic": "catalog:",
    "concurrently": "catalog:",
    "http-server": "catalog:",
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "10.30.3"
  },
  "volta": {
    "node": "24.14.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "micromatch": "4.0.8",
      "esbuild": "0.25.9",
      "rollup": "4.59.0",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "basic-ftp": "5.3.0",
      "koa": "2.16.4",
      "axios": "1.15.0",
      "qs": "6.15.0",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
      "lodash": "4.18.1",
      "diff@>=5.0.0 <5.2.2": "5.2.2",
      "mdast-util-to-hast": "13.2.1",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "tar-fs@<3.1.1": "3.1.1",
      "brace-expansion@<2.1.4": "2.1.4",
      "brace-expansion@>=4.0.0 <5.0.5": "5.0.5",
      "follow-redirects": "1.16.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "flatted": "3.4.2",
      "defu": "6.1.7",
      "smol-toml": "1.6.1",
      "h3@>=1.0.0 <1.15.9": "1.15.9",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.23": "8.5.23",
      "sharp@<0.35.0": "0.35.3"
    }
  }
}
