{
  "name": "aetherui",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for AetherUI - A headless, framework-agnostic Web Component library",
  "author": "AetherUI Contributors",
  "license": "MIT",
  "homepage": "https://github.com/pallavL01/AetherUI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pallavL01/AetherUI.git"
  },
  "bugs": {
    "url": "https://github.com/pallavL01/AetherUI/issues"
  },
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": "10.10.0"
  },
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=4096' nx run-many -t build --parallel=2",
    "build:affected": "NODE_OPTIONS='--max-old-space-size=4096' nx affected -t build --parallel=2",
    "dev": "nx run-many -t dev --parallel=2",
    "lint": "nx run-many -t lint --parallel=2",
    "test": "node scripts/check-test-env.js 'NODE_OPTIONS=\"--max-old-space-size=2048\" nx run-many -t test --parallel=2'",
    "test:memory": "nx run-many -t test:memory --sequential",
    "test:changed": "node scripts/check-test-env.js 'NODE_OPTIONS=\"--max-old-space-size=2048\" nx affected -t test --parallel=2'",
    "clean": "nx run-many -t clean --parallel=2",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install",
    "storybook": "nx run @aetherui/storybook:storybook",
    "build-storybook": "nx run @aetherui/storybook:build-storybook",
    "docs": "nx run-many -t docs --parallel=1",
    "docs:dev": "nx run @aetherui/docs:dev",
    "docs:build": "NODE_OPTIONS='--max-old-space-size=4096' nx run-many -t docs:build --parallel=1",
    "deploy:docs": "pnpm docs:build && pnpm run docs:deploy",
    "docs:deploy": "touch packages/docs/dist/.nojekyll && pnpm run docs:push-gh-pages",
    "docs:push-gh-pages": "git checkout gh-pages && git pull && rm -rf docs && cp -r packages/docs/dist docs && git add docs && git commit -m \"Update docs\" && git push && git checkout -",
    "graph": "nx graph",
    "nx:graph": "nx graph",
    "nx:reset": "nx reset",
    "build:parallel": "NODE_OPTIONS='--max-old-space-size=4096' nx run-many -t build --parallel=3"
  },
  "devDependencies": {
    "@nx/js": "^21.0.3",
    "@nx/vite": "^21.0.3",
    "@nx/web": "^21.0.3",
    "@open-wc/testing": "^4.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/ui": "^3.0.0",
    "@web/dev-server-esbuild": "^1.0.4",
    "@web/test-runner": "^0.20.1",
    "@web/test-runner-playwright": "^0.11.0",
    "esbuild-plugin-lit-css": "^3.0.2",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^14.0.0",
    "nx": "^21.0.3",
    "prettier": "^3.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "micromatch": "^4.0.8",
      "esbuild": "^0.25.0"
    }
  }
}
