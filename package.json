{
  "name": "aetherui",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": "10.10.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "build:affected": "nx affected -t build",
    "dev": "nx run-many -t dev",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:fast": "nx run-many -t test --parallel=3",
    "test:memory": "nx run-many -t test:memory --sequential",
    "test:api": "nx run-many -t test:api",
    "test:wc": "nx run-many -t test:wc",
    "test:changed": "nx affected -t test",
    "clean": "nx run-many -t clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install",
    "storybook": "nx run @aetherui/storybook:storybook",
    "build-storybook": "nx run @aetherui/storybook:build-storybook",
    "docs": "nx run-many -t docs",
    "docs:build": "nx run-many -t docs:build",
    "nx:graph": "nx graph",
    "nx:reset": "nx reset",
    "build:parallel": "nx run-many -t build --parallel --max-parallel=8"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.27.1",
    "@babel/plugin-transform-class-static-block": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@nx/js": "^21.0.3",
    "@nx/storybook": "^21.0.3",
    "@nx/vite": "^21.0.3",
    "@nx/web": "^21.0.3",
    "@open-wc/testing": "^4.0.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/jest": "^29.5.14",
    "@types/jscodeshift": "^17.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/ui": "^3.0.0",
    "@web/dev-server-esbuild": "^1.0.4",
    "@web/test-runner": "^0.20.1",
    "@web/test-runner-playwright": "^0.11.0",
    "esbuild-plugin-lit-css": "^3.0.2",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^8.0.0",
    "jiti": "2.4.2",
    "lint-staged": "^14.0.0",
    "nx": "^21.0.3",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "micromatch": "^4.0.8",
      "esbuild": "^0.25.0"
    }
  }
}
