name: Build and Deploy to GitHub Pages

on:
  # Runs on pushes targeting the default branch
  push:
    branches: ["main"]
  
  # Allows you to run this workflow manually from the Actions tab
  workflow_dispatch:

# Sets permissions of the GITHUB_TOKEN to allow deployment to GitHub Pages
permissions:
  contents: read
  pages: write
  id-token: write

# Allow only one concurrent deployment
concurrency:
  group: "pages"
  cancel-in-progress: true

jobs:
  # Build main site
  build-main:
    name: Build Main Site
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
        
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 18
          
      - name: Setup pnpm
        uses: pnpm/action-setup@v2
        with:
          version: 10.10.0
          run_install: false
          
      - name: Get pnpm store directory
        id: pnpm-cache
        shell: bash
        run: echo "STORE_PATH=$(pnpm store path)" >> $GITHUB_OUTPUT
        
      - name: Setup pnpm cache
        uses: actions/cache@v4
        with:
          path: ${{ steps.pnpm-cache.outputs.STORE_PATH }}
          key: ${{ runner.os }}-pnpm-store-${{ hashFiles('**/pnpm-lock.yaml') }}
          restore-keys: |
            ${{ runner.os }}-pnpm-store-
            
      - name: Install dependencies
        run: |
          # Use --no-frozen-lockfile to handle dependency mismatches
          pnpm install --no-frozen-lockfile

      # Create a simple landing page
      - name: Prepare main site
        run: |
          # Create output directory with debug info
          mkdir -p ./output-main
          ls -la ./
          echo "Creating main site landing page..."

          # Create a simple landing page that links to both docs and storybook
          cat > ./output-main/index.html << 'EOF'
          <!DOCTYPE html>
          <html lang="en">
          <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>AetherUI</title>
            <style>
              body {
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
                max-width: 800px;
                margin: 0 auto;
                padding: 20px;
                line-height: 1.6;
                text-align: center;
              }
              .container {
                margin-top: 100px;
              }
              h1 {
                font-size: 3rem;
                margin-bottom: 1rem;
              }
              .links {
                display: flex;
                justify-content: center;
                gap: 20px;
                margin-top: 40px;
              }
              .link {
                display: inline-block;
                background: #3a86ff;
                color: white;
                padding: 15px 30px;
                border-radius: 4px;
                text-decoration: none;
                font-weight: bold;
                transition: background 0.2s;
              }
              .link:hover {
                background: #2563eb;
              }
            </style>
          </head>
          <body>
            <div class="container">
              <h1>AetherUI</h1>
              <p>A headless, framework-agnostic Web Component library</p>
              <div class="links">
                <a href="https://pallavl01.github.io/AetherUI/docs/" class="link">Documentation</a>
                <a href="https://pallavl01.github.io/AetherUI/storybook/" class="link">Storybook</a>
              </div>
            </div>
          </body>
          </html>
          EOF

      # Upload the main site artifact with retention
      - name: Upload main site artifact
        uses: actions/upload-artifact@v4
        with:
          name: main-site-artifact
          path: ./output-main
          retention-days: 1
          if-no-files-found: warn

  # Build docs
  build-docs:
    name: Build Docs
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
        
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 18
          
      - name: Setup pnpm
        uses: pnpm/action-setup@v2
        with:
          version: 10.10.0
          run_install: false
          
      - name: Get pnpm store directory
        id: pnpm-cache
        shell: bash
        run: echo "STORE_PATH=$(pnpm store path)" >> $GITHUB_OUTPUT
        
      - name: Setup pnpm cache
        uses: actions/cache@v4
        with:
          path: ${{ steps.pnpm-cache.outputs.STORE_PATH }}
          key: ${{ runner.os }}-pnpm-store-${{ hashFiles('**/pnpm-lock.yaml') }}
          restore-keys: |
            ${{ runner.os }}-pnpm-store-
            
      - name: Install dependencies
        run: |
          pnpm install --no-frozen-lockfile

      # Build Core Packages First
      - name: Build dependencies
        run: |
          echo "Building core and tokens packages..."
          pnpm turbo run build --filter="@aetherui/core" --filter="@aetherui/tokens" --no-daemon

      # Build Astro docs with error handling
      - name: Build docs
        id: build-docs
        continue-on-error: true
        run: |
          cd packages/docs
          pnpm build
          echo "DOCS_BUILD_SUCCESS=true" >> $GITHUB_ENV

      # Create a fallback page if the build fails
      - name: Check docs build status
        if: steps.build-docs.outcome != 'success'
        run: |
          echo "Docs build failed, preparing fallback"
          echo "DOCS_BUILD_SUCCESS=false" >> $GITHUB_ENV
          
          # Create dist directory if it doesn't exist
          mkdir -p packages/docs/dist
          
          # Check if we already have content (partial build may have succeeded)
          if [ ! -f "packages/docs/dist/index.html" ]; then
            echo "Creating minimal fallback page"
            cp -r packages/docs/static-html/* packages/docs/dist/ || true
          fi

      # Upload the docs artifact with retention
      - name: Upload docs artifact
        uses: actions/upload-artifact@v4
        with:
          name: docs-site-artifact
          path: packages/docs/dist
          retention-days: 1

  # Build Storybook
  build-storybook:
    name: Build Storybook
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
        
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 18
          
      - name: Setup pnpm
        uses: pnpm/action-setup@v2
        with:
          version: 10.10.0
          run_install: false
          
      - name: Get pnpm store directory
        id: pnpm-cache
        shell: bash
        run: echo "STORE_PATH=$(pnpm store path)" >> $GITHUB_OUTPUT
        
      - name: Setup pnpm cache
        uses: actions/cache@v4
        with:
          path: ${{ steps.pnpm-cache.outputs.STORE_PATH }}
          key: ${{ runner.os }}-pnpm-store-${{ hashFiles('**/pnpm-lock.yaml') }}
          restore-keys: |
            ${{ runner.os }}-pnpm-store-
            
      - name: Install dependencies
        run: |
          pnpm install --no-frozen-lockfile

      # Build Core Packages First
      - name: Build dependencies
        run: |
          echo "Building core and tokens packages..."
          pnpm turbo run build --filter="@aetherui/core" --filter="@aetherui/tokens" --no-daemon

      # Build Storybook with error handling
      - name: Build Storybook
        id: build-storybook
        continue-on-error: true
        run: |
          cd packages/storybook
          pnpm build-storybook
          echo "STORYBOOK_BUILD_SUCCESS=true" >> $GITHUB_ENV
          
      # Create a fallback if the build fails
      - name: Check Storybook build status
        if: steps.build-storybook.outcome != 'success'
        run: |
          echo "Storybook build failed, preparing fallback"
          echo "STORYBOOK_BUILD_SUCCESS=false" >> $GITHUB_ENV
          
          # Create storybook-static directory if it doesn't exist
          mkdir -p packages/storybook/storybook-static
          
          # Create minimal fallback page if needed
          if [ ! -f "packages/storybook/storybook-static/index.html" ]; then
            echo "<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><title>AetherUI Storybook</title><meta http-equiv=\"refresh\" content=\"0;url=https://pallavl01.github.io/AetherUI/\"></head><body><p>Redirecting to <a href=\"https://pallavl01.github.io/AetherUI/\">AetherUI</a>...</p></body></html>" > packages/storybook/storybook-static/index.html
          fi

      # Upload the Storybook artifact with retention
      - name: Upload Storybook artifact
        uses: actions/upload-artifact@v4
        with:
          name: storybook-site-artifact
          path: packages/storybook/storybook-static
          retention-days: 1

  # Deploy combined site to GitHub Pages
  deploy-combined:
    name: Deploy Combined Site
    needs: [build-main, build-docs, build-storybook]
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: https://pallavl01.github.io/AetherUI
    steps:
      - name: Setup Pages
        uses: actions/configure-pages@v4

      # Create output directories
      - name: Create output directories
        run: |
          mkdir -p ./.output
          mkdir -p ./.output/docs
          mkdir -p ./.output/storybook

      # Download all artifacts with better error handling
      - name: Download main site artifact
        uses: actions/download-artifact@v4
        id: download-main
        continue-on-error: true
        with:
          name: main-site-artifact
          path: ./.output

      - name: Create fallback main page if download fails
        if: steps.download-main.outcome != 'success'
        run: |
          echo "Creating fallback main page..."
          cat > ./.output/index.html << 'EOF'
          <!DOCTYPE html>
          <html lang="en">
          <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>AetherUI</title>
            <style>
              body { font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; text-align: center; }
              .container { margin-top: 100px; }
              h1 { font-size: 2.5rem; margin-bottom: 1rem; }
              .links { display: flex; justify-content: center; gap: 20px; margin-top: 40px; }
              .link { display: inline-block; background: #3a86ff; color: white; padding: 15px 30px; border-radius: 4px; text-decoration: none; font-weight: bold; }
            </style>
          </head>
          <body>
            <div class="container">
              <h1>AetherUI</h1>
              <p>A headless, framework-agnostic Web Component library</p>
              <div class="links">
                <a href="./docs/" class="link">Documentation</a>
                <a href="./storybook/" class="link">Storybook</a>
              </div>
            </div>
          </body>
          </html>
          EOF

      - name: Download docs artifact
        uses: actions/download-artifact@v4
        id: download-docs
        continue-on-error: true
        with:
          name: docs-site-artifact
          path: ./.output/docs

      - name: Create fallback docs page if download fails
        if: steps.download-docs.outcome != 'success'
        run: |
          echo "Creating fallback docs page..."
          cat > ./.output/docs/index.html << 'EOF'
          <!DOCTYPE html>
          <html lang="en">
          <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>AetherUI Documentation</title>
            <style>
              body { font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; }
              .notice { background: #f0f4f8; border-left: 4px solid #3a86ff; padding: 20px; margin: 20px 0; border-radius: 4px; }
            </style>
          </head>
          <body>
            <h1>AetherUI Documentation</h1>
            <div class="notice">
              <p><strong>Notice:</strong> Documentation is being updated. Please check back soon.</p>
              <p><a href="../">Return to AetherUI home</a></p>
            </div>
          </body>
          </html>
          EOF

      - name: Download Storybook artifact
        uses: actions/download-artifact@v4
        id: download-storybook
        continue-on-error: true
        with:
          name: storybook-site-artifact
          path: ./.output/storybook

      - name: Create fallback Storybook page if download fails
        if: steps.download-storybook.outcome != 'success'
        run: |
          echo "Creating fallback Storybook page..."
          cat > ./.output/storybook/index.html << 'EOF'
          <!DOCTYPE html>
          <html lang="en">
          <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>AetherUI Storybook</title>
            <style>
              body { font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; }
              .notice { background: #f0f4f8; border-left: 4px solid #3a86ff; padding: 20px; margin: 20px 0; border-radius: 4px; }
            </style>
          </head>
          <body>
            <h1>AetherUI Storybook</h1>
            <div class="notice">
              <p><strong>Notice:</strong> Storybook is being updated. Please check back soon.</p>
              <p><a href="../">Return to AetherUI home</a></p>
            </div>
          </body>
          </html>
          EOF

      # Debug: List the combined output structure
      - name: List combined output structure
        run: |
          echo "Combined output structure:"
          find ./.output -type f | sort

      # Upload combined site artifact
      - name: Upload combined site artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: ./.output

      # Deploy to GitHub Pages
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4